package templates

import "github.com/go-go-golems/go-go-labs/cmd/apps/friday-talks/internal/models"

templ Login(errorString string) {
	@Layout("Login", nil) {
		<div class="row justify-content-center">
			<div class="col-md-6">
				<div class="card">
					<div class="card-header">
						<h3 class="mb-0">Login</h3>
					</div>
					<div class="card-body">
						<div id="login-form-container">
							@_loginForm(errorString)
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}

templ Register(errorString string) {
	@Layout("Register", nil) {
		<div class="row justify-content-center">
			<div class="col-md-6">
				<div class="card">
					<div class="card-header">
						<h3 class="mb-0">Register</h3>
					</div>
					<div class="card-body">
						<div id="register-form-container">
							@_registerForm(errorString)
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}

templ Profile(user *models.User, successString string, errorString string) {
	@Layout("My Profile", user) {
		<div class="row justify-content-center">
			<div class="col-md-8">
				<div class="card">
					<div class="card-header d-flex justify-content-between align-items-center">
						<h3 class="mb-0">My Profile</h3>
					</div>
					<div class="card-body">
						<div id="profile-form-container">
							@_profileForm(user, successString, errorString)
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}