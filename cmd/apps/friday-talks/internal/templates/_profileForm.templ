package templates

import "github.com/go-go-golems/go-go-labs/cmd/apps/friday-talks/internal/models"

// _profileForm renders the user profile update form.
templ _profileForm(user *models.User, successString string, errorString string) {
	if successString != "" {
		@Alert("success", successString)
	}
	if errorString != "" {
		@Alert("danger", errorString)
	}
	<form 
		hx-post="/profile"
		hx-target="#profile-form-container"
		hx-swap="outerHTML"
		>
		<div class="mb-3">
			<label for="name" class="form-label">Name</label>
			<input type="text" class="form-control" id="name" name="name" value={ user.Name } required/>
		</div>
		<div class="mb-3">
			<label for="email" class="form-label">Email</label>
			<input type="email" class="form-control" id="email" name="email" value={ user.Email } required/>
		</div>
		<hr/>
		<h5>Change Password (Optional)</h5>
		<div class="mb-3">
			<label for="current_password" class="form-label">Current Password</label>
			<input type="password" class="form-control" id="current_password" name="current_password"/>
		</div>
		<div class="mb-3">
			<label for="new_password" class="form-label">New Password</label>
			<input type="password" class="form-control" id="new_password" name="new_password" minlength="8"/>
		</div>
		<div class="mb-3">
			<label for="confirm_password" class="form-label">Confirm New Password</label>
			<input type="password" class="form-control" id="confirm_password" name="confirm_password" minlength="8"/>
		</div>
		<div class="d-flex justify-content-end">
			<button type="submit" class="btn btn-primary">Save Changes</button>
		</div>
	</form>
} 