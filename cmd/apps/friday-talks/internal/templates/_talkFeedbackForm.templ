package templates

import (
	"fmt"
	"github.com/go-go-golems/go-go-labs/cmd/apps/friday-talks/internal/models"
)

// _talkFeedbackForm renders the feedback form for a completed talk.
templ _talkFeedbackForm(user *models.User, talk *models.Talk, attendance *models.Attendance, errorString string, successString string) {
	if errorString != "" {
		@Alert("danger", errorString)
	}
	if successString != "" {
		@Alert("success", successString)
	}

	if talk.Status == models.TalkStatusCompleted && user != nil && attendance != nil && attendance.Status == models.AttendanceStatusAttended {
		if attendance.Feedback == "" {
			<div class="mt-4">
				<h5>Share Your Feedback</h5>
				<form 
					hx-post={ templ.SafeURL(fmt.Sprintf("/talks/%d/feedback", talk.ID)) } 
					hx-target="#feedback-section" 
					hx-swap="outerHTML"
					class="mb-3">
					<div class="mb-3">
						<label for="feedback" class="form-label">Your thoughts on this talk</label>
						<textarea class="form-control" id="feedback" name="feedback" rows="3" required></textarea>
					</div>
					<button type="submit" class="btn btn-primary">Submit Feedback</button>
				</form>
			</div>
		} else {
			<div class="alert alert-info mt-4">
				Thank you for your feedback!
			</div>
		}
	}
} 