package templates

import (
	"github.com/go-go-golems/go-go-labs/cmd/apps/friday-talks/internal/models"
	"fmt"
)

// _talkManagementCard renders the management actions for a talk.
// Handles HTMX updates for completing and cancelling talks.
templ _talkManagementCard(user *models.User, talk *models.Talk, errorString string, successString string) {
	<div id="talk-management-card">
		if user != nil && (user.ID == talk.SpeakerID || isAdminUser(user)) {
			<div class="card mb-4">
				<div class="card-header d-flex justify-content-between align-items-center">
					<h5 class="mb-0">Manage Talk</h5>
					<div class="htmx-indicator">
						@LoadingSpinner()
					</div>
				</div>
				<div class="card-body">
					// Display alerts specific to this card
					if errorString != "" {
						@Alert("danger", errorString)
					}
					if successString != "" {
						@Alert("success", successString)
					}
					
					if talk.Status == models.TalkStatusProposed {
						if isAdminUser(user) {
							// Keep Schedule as a normal link for now
							<a href={ templ.SafeURL(fmt.Sprintf("/talks/%d/schedule", talk.ID)) } class="btn btn-success d-block mb-2">Schedule This Talk</a>
						}
						<a href={ templ.SafeURL(fmt.Sprintf("/talks/%d/edit", talk.ID)) } class="btn btn-primary d-block mb-2">Edit Talk</a>
						<button
							type="button"
							class="btn btn-danger d-block w-100"
							hx-post={ templ.SafeURL(fmt.Sprintf("/talks/%d/cancel", talk.ID)) }
							hx-target="#talk-management-card"
							hx-swap="outerHTML"
							hx-confirm="Are you sure you want to cancel this talk proposal?"
							hx-indicator="#talk-management-card .htmx-indicator"
						>
							Cancel Proposal
						</button>
					} else if talk.Status == models.TalkStatusScheduled {
						if isAdminUser(user) {
							<button
								type="button"
								class="btn btn-success d-block w-100 mb-2"
								hx-post={ templ.SafeURL(fmt.Sprintf("/talks/%d/complete", talk.ID)) }
								hx-target="#talk-management-card"
								hx-swap="outerHTML"
								hx-indicator="#talk-management-card .htmx-indicator"
							>
								Mark as Completed
							</button>
							<button
								type="button"
								class="btn btn-danger d-block w-100"
								hx-post={ templ.SafeURL(fmt.Sprintf("/talks/%d/cancel", talk.ID)) }
								hx-target="#talk-management-card"
								hx-swap="outerHTML"
								hx-confirm="Are you sure you want to cancel this scheduled talk?"
								hx-indicator="#talk-management-card .htmx-indicator"
							>
								Cancel Talk
							</button>
						}
					} else {
						<p class="text-muted">No management actions available for this talk status.</p>
					}
				</div>
			</div>
		} 
	</div>
} 